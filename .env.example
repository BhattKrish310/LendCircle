# LendCircle - Environment Variables Template
# Copy this file to .env and replace with your local configuration

# Flask Security Key
SECRET_KEY=replace-with-a-secure-random-secret-key

# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=p2p_lending_db
